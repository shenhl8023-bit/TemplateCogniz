{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kmsoft.local/schemas/select_group_template.propose.response.schema.json",
  "title": "SelectGroupTemplateProposeResponse",
  "type": "object",
  "required": ["ok", "action", "stage", "mode", "workflow", "ui", "candidates"],
  "additionalProperties": true,
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "action": {
      "const": "propose"
    },
    "stage": {
      "const": "select_group_template"
    },
    "mode": {
      "enum": ["awaiting_choice", "needs_input"]
    },
    "reply": {
      "type": "string"
    },
    "workflow": {
      "$ref": "#/$defs/workflow"
    },
    "ui": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/optionCards"
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/templateCandidate"
      }
    }
  },
  "$defs": {
    "workflow": {
      "type": "object",
      "required": ["currentStep", "steps"],
      "properties": {
        "currentStep": {
          "const": "select_group_template"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "title", "status"],
            "properties": {
              "id": { "const": "select_group_template" },
              "title": { "const": "选择分组模板" },
              "status": { "enum": ["awaiting_choice", "needs_input"] }
            }
          }
        }
      }
    },
    "optionCards": {
      "type": "object",
      "required": ["type", "id", "stage", "title", "options"],
      "properties": {
        "type": { "const": "option_cards" },
        "id": { "const": "group_template_candidates" },
        "stage": { "const": "select_group_template" },
        "title": { "type": "string" },
        "options": {
          "type": "array",
          "items": { "$ref": "#/$defs/templateOption" }
        }
      }
    },
    "templateOption": {
      "type": "object",
      "required": ["id", "choiceId", "templateId", "title", "confidence", "selected"],
      "properties": {
        "id": { "type": "string" },
        "choiceId": { "type": "string" },
        "templateId": { "type": "string" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "confidence": { "type": "number" },
        "reasons": { "type": "array", "items": { "type": "string" } },
        "tags": { "type": "array", "items": { "type": "string" } },
        "selected": { "type": "boolean" }
      }
    },
    "templateCandidate": {
      "type": "object",
      "required": ["id", "templateId", "filename", "displayName", "confidence", "groupCount", "depth"],
      "properties": {
        "id": { "type": "string" },
        "templateId": { "type": "string" },
        "filename": { "type": "string" },
        "displayName": { "type": "string" },
        "relativePath": { "type": "string" },
        "confidence": { "type": "number" },
        "score": { "type": "number" },
        "groupCount": { "type": "integer" },
        "depth": { "type": "integer" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "scoreBreakdown": { "$ref": "#/$defs/scoreBreakdown" }
      }
    },
    "scoreBreakdown": {
      "type": "object",
      "properties": {
        "domain": {
          "type": "array",
          "items": { "$ref": "#/$defs/scoreComponent" }
        },
        "feature": {
          "type": "array",
          "items": { "$ref": "#/$defs/scoreComponent" }
        },
        "lexical": { "type": "number" },
        "groupComplexity": { "type": "number" },
        "featureComplexity": { "type": "number" }
      }
    },
    "scoreComponent": {
      "type": "object",
      "required": ["label", "score"],
      "properties": {
        "label": { "type": "string" },
        "score": { "type": "number" }
      }
    }
  }
}
